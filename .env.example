# =============================================================================
# Hospital Management System - environment template
#
#   cp .env.example .env   and replace every CHANGE_ME value.
#   .env is git-ignored and must never be committed.
# =============================================================================

# ----------------------------------------------------------------- application
NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0

# ------------------------------------------------------------------- database
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_db
DB_USER=hms_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_LOGGING=false
DB_POOL_MAX=10

# Root password used only by the MySQL container in docker-compose.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ------------------------------------------------------------ authentication
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------- http
# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Stricter budget for /api/auth/login and /api/auth/register.
AUTH_RATE_LIMIT_MAX=20

# -------------------------------------------------------------- docker compose
# Host ports. MySQL defaults to 3307 to avoid clashing with a local MySQL.
MYSQL_PORT=3307
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Startup behaviour of the backend container.
RUN_MIGRATIONS=true
RUN_SEEDERS=true
SEED_PASSWORD=Password@123

# ------------------------------------------------------------------- frontend
# Dev server proxy target (vite). Leave as-is for local development.
VITE_DEV_API_PROXY=http://localhost:5000
# Runtime API base URL injected into the built SPA. '/api' keeps it same-origin.
FRONTEND_API_URL=/api

# --------------------------------------------------------- docker registry / CD
# Used by docker-compose image names and the Jenkins pipeline.
# The actual registry credentials live in Jenkins Credentials Manager
# (docker-hub-credentials) - never put them in this file or in git.
DOCKER_USERNAME=your-dockerhub-username
DOCKER_REGISTRY=docker.io
IMAGE_TAG=latest
